      }
      if (!selected || !guidance[selected]) {
        result.innerHTML = '<h3>Please select a symptom</h3><p>Choose your main symptom to view general educational information.</p>';
        return;
      }
      const item = guidance[selected];
      result.innerHTML = '<h3>General health information</h3>' +
        '<p><strong>Possible explanations (not a diagnosis):</strong></p><ul>' +
        item.causes.map(function (cause) { return '<li>' + cause + '</li>'; }).join('') +
        '</ul><p><strong>Suggested next step:</strong> ' + item.advice + '</p>' +
        '<p class="small">Symptoms can have many causes. A qualified healthcare professional must assess you and make any diagnosis.</p>';

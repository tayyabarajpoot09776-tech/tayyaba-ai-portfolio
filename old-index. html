lamp(18px,3vw,34px);margin-top:25px}.field{display:block;font-size:.87rem;font-weight:750;margin:16px 0 8px}select,input{width:100%;border:1px solid #3d6271;border-radius:12px;background:#081b2a;color:white;padding:14px;outline-offset:3px}select:focus,input:focus{outline:2px solid var(--a)}.checkgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:17px 0}.check{display:flex;gap:10px;align-items:flex-start;border:1px solid #315466;border-radius:12px;padding:12px;background:#0b2332}.check input{width:auto;accent-color:#5de6c9;margin-top:5px}.result{display:none;margin-top:22px;padding:20px;border:1px solid #478e91;background:#092c32;border-radius:15px}.result.show{display:block}.result h3{margin:0 0 10px;color:#8dfce0}.result ul{padding-left:22px}.result li{margin:7px 0}.warn{color:#ffd1b1}.searchrow{display:grid;grid-template-columns:1fr auto;gap:10px}.small{font-size:.85rem;color:var(--muted)}.foot{border-top:1px solid var(--line);padding:30px 0 50px;color:var(--muted);font-size:.9rem}.footin{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.pill{display:inline-block;border:1px solid #386779;padding:6px 12px;border-radius:50px;color:#b4e6e6;font-size:.78rem;margin:4px 4px 0 0}.hide{display:none!important}@media(max-width:800px){.hero{grid-template-columns:1fr;padding:52px 0 25px;min-height:0}.orbbox{height:280px;order:-1}.orb{width:185px;height:185px}.orb:after{font-size:65px}.ring{width:240px;height:95px}.ring.two{width:230px;height:110px}.grid{grid-template-columns:1fr 1fr}.links{gap:12px;font-size:.76rem}.navin{padding:12px 0;align-items:flex-start;flex-direction:column}.hero h1{font-size:clamp(2.3rem,9vw,4rem)}}@media(max-width:540px){.grid,.checkgrid,.searchrow{grid-template-columns:1fr}.card{padding:20px}.orbbox{height:245px}section{padding:45px 0}.hero{gap:12px}.navin{gap:9px}.links{gap:12px}.btn{width:100%;text-align:center}}

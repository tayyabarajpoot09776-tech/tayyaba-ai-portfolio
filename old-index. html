      name: 'Metformin',
      use: 'A prescription medicine commonly used to help manage type 2 diabetes.',
      caution: 'Use only as prescribed. Your clinician may need to consider kidney function and other health factors.'
    },
    omeprazole: {
      name: 'Omeprazole',
      use: 'A medicine that reduces stomach acid and is used for some acid-related conditions.',
      caution: 'Ask a healthcare professional how long to use it and whether it is appropriate for your symptoms.'
    },
    cetirizine: {
      name: 'Cetirizine',
      use: 'An antihistamine commonly used for allergy symptoms such as sneezing, itching, and runny nose.',
      caution: 'It can cause drowsiness in some people. Check with a pharmacist about other medicines and driving.'
    },
    atorvastatin: {
      name: 'Atorvastatin',
      use: 'A prescription statin used to lower cholesterol and reduce certain cardiovascular risks.',
      caution: 'Use as prescribed and discuss unexplained muscle pain, weakness, or other concerning symptoms with your clinician.'
    }
  };

  const medicineButton = document.getElementById('medicineBtn');
  const medicineInput = document.getElementById('medicineSearch');
  const medicineResult = document.getElementById('medicineResult');

  function searchMedicine() {
    const query = (medicineInput.value || '').trim().toLowerCase();
    medicineResult.classList.add('show');
    if (!query) {
      medicineResult.innerHTML = '<h3>Enter a medicine name</h3><p>Type a generic or brand name to search this small educational demo library.</p>';
      return;
    }

    const found = medicineInfo[query];
    if (!found) {
      const safeQuery = encodeURIComponent(query);
      medicineResult.innerHTML = '<h3>No entry in this demo library</h3>' +
        '<p>This website’s sample library does not contain “' + query.replace(/[&<>"']/g, '') + '”. This does not mean the medicine is unsafe or unknown.</p>' +
        '<p><a href="https://medlineplus.gov/druginformation.html" target="_blank" rel="noopener noreferrer" style="color:var(--a);text-decoration:underline">Search trusted medicine information on MedlinePlus</a></p>';
      return;
    }

    medicineResult.innerHTML = '<h3>' + found.name + '</h3>' +
      '<p><strong>Common use:</strong> ' + found.use + '</p>' +
      '<p><strong>Important precaution:</strong> ' + found.caution + '</p>' +
      '<p class="small">This is general information, not a recommendation to take this medicine. Follow your prescriber’s instructions and ask a pharmacist about your own situation.</p>' +
      '<p><a href="https://medlineplus.gov/druginformation.html" target="_blank" rel="noopener noreferrer" style="color:var(--a);text-decoration:underline">Read more on MedlinePlus</a></p>';
  }

  if (medicineButton) medicineButton.addEventListener('click', searchMedicine);
  if (medicineInput) {
    medicineInput.addEventListener('keydown', function (event) {
      if (event.key === 'Enter') searchMedicine();
    });
  }

  const findCareButton = document.getElementById('findCare');
  if (findCareButton) {
    findCareButton.addEventListener('click', function () {
      const city = (document.getElementById('city').value || '').trim();
      const specialty = document.getElementById('specialty').value;
      const message = document.getElementById('careMessage');

      if (!city) {
        message.textContent = 'Please enter a city or area first.';
        document.getElementById('city').focus();
        return;
      }

      const mapsUrl = 'https://www.google.com/maps/search/' +
        encodeURIComponent(specialty + ' in ' + city);
      window.open(mapsUrl, '_blank', 'noopener,noreferrer');
      message.textContent = 'Google Maps search opened. Please verify services, availability, and opening hours directly with the provider.';
    });
  }

  // MediBot is an offline educational demo. It does not connect to a live AI service.
  function medibotReply(message) {
    const q = message.toLowerCase();
    if (/emergency|can't breathe|cannot breathe|chest pain|stroke|faint|unconscious|bleeding heavily/.test(q)) {
      return 'This may be an emergency. Please contact local emergency services or go to the nearest emergency department now. Do not wait for an online response.';
    }
    if (/symptom|headache|fever|cough|stomach|rash|dizz|tired|fatigue|pain/.test(q)) {
      return 'Symptoms can have many possible causes, and I cannot diagnose them. Use the Symptom Explorer on this page for general educational guidance. If symptoms are severe, sudden, worsening, or worrying, contact a qualified healthcare professional.';
    }
    if (/medicine|medication|tablet|dose|panadol|paracetamol|ibuprofen|antibiotic|amoxicillin/.test(q)) {
      return 'You can use the Medicine Information section to look up a few common medicines. Do not start, stop, or change a medicine or dose based on this demo. Follow your prescriber’s instructions and ask a pharmacist about interactions and precautions.';
    }
    if (/hospital|doctor|clinic|specialist|cardiologist|neurologist/.test(q)) {
      return 'Go to the Find Care section, enter your city or area, choose the type of care, and select Search Healthcare Providers. Google Maps will open. Please call the provider to confirm services and availability.';
    }
    if (/hello|hi|hey/.test(q)) {
      return 'Hello! I can guide you to the Symptom Explorer, Medicine Information, or Find Care sections. What would you like help finding?';
    }
    if (/who are you|what can you do|help/.test(q)) {
      return 'I am MediBot, a simple healthcare website assistant demo. I can explain how to use this website and share general educational information. I am not a live clinical AI and cannot diagnose or prescribe.';
    }
    return 'Thanks for your question. This demo assistant has limited offline responses. Please explore the Symptom, Medicine, and Find Care sections, and consult a qualified healthcare professional for personal medical advice.';
  }

  function attachChat(formId, inputId, messagesId) {
    const form = document.getElementById(formId);
    const input = document.getElementById(inputId);
    const messages = document.getElementById(messagesId);
    if (!form || !input || !messages) return;
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      const value = input.value.trim();
      if (!value) return;
      const userBubble = document.createElement('div');
      userBubble.className = 'chat-bubble user';
      userBubble.textContent = value;
      messages.appendChild(userBubble);
      const botBubble = document.createElement('div');
      botBubble.className = 'chat-bubble bot';
      botBubble.textContent = medibotReply(value);
      messages.appendChild(botBubble);
      input.value = '';
      messages.scrollTop = messages.scrollHeight;
    });
  }
  attachChat('pageChatForm', 'pageChatInput', 'pageChatMessages');
  attachChat('popupChatForm', 'popupChatInput', 'popupChatMessages');
  const floatButton = document.getElementById('chatFloatButton');
  const popup = document.getElementById('chatPopup');
  const closeButton = document.getElementById('chatClose');
  if (floatButton && popup) {
    floatButton.addEventListener('click', function () {
      const open = popup.classList.toggle('open');
      floatButton.setAttribute('aria-expanded', String(open));
    });
  }
  if (closeButton && popup && floatButton) {
    closeButton.addEventListener('click', function () {
      popup.classList.remove('open');
      floatButton.setAttribute('aria-expanded', 'false');
    });
  }

  })();
</script>
<button class="chat-float" id="chatFloatButton" type="button" aria-expanded="false">✚ Chat with MediBot</button><div class="chat-pop" id="chatPopup" aria-label="MediBot chat window"><div class="chat-head"><div class="bot-avatar">✚</div><div><strong>MediBot AI Assistant</strong><div class="small">Healthcare information demo</div></div><button type="button" id="chatClose" class="btn" style="margin-left:auto;padding:5px 10px">×</button></div><div class="chat-messages" id="popupChatMessages"><div class="chat-bubble bot">Hi! Ask me about this website, general symptoms, medicines, or finding care.</div></div><form class="chat-compose" id="popupChatForm"><input id="popupChatInput" type="text" placeholder="Ask MediBot..." aria-label="Ask MediBot" required><button class="btn primary" type="submit">Send</button></form></div></body>
</html>

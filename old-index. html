      advice: 'Consult a clinician for a persistent cough, blood in mucus, worsening illness, or breathing concerns.'
    },
    stomach: {
      causes: ['Indigestion or constipation', 'Gastrointestinal infection', 'Other abdominal conditions'],
      advice: 'Severe, localized, persistent, or worsening abdominal pain needs urgent clinical assessment.'

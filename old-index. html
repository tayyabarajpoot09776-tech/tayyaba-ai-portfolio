      const redFlags = Array.from(document.querySelectorAll('.redflag:checked')).map(function (item) {
        return item.value;
      });

      result.classList.add('show');
      if (redFlags.length) {
        result.innerHTML = '<h3>Urgent medical attention may be needed</h3>' +
          '<p class="warn">You selected one or more warning signs:</p><ul>' +
          redFlags.map(function (item) { return '<li>' + item + '</li>'; }).join('') +
          '</ul><p>Please seek emergency medical help now. Do not wait for an online tool or use this result to decide that it is safe to stay home.</p>';



<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="VITALIS Healthcare AI - Explore symptoms, medicine information and hospital search with a healthcare chatbot.">
<title>VITALIS | Healthcare AI</title>

<style>
:root {
  --primary:#087f8c;
  --dark:#102b3a;
  --light:#eff9fa;
  --white:#ffffff;
}
* { box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  margin:0;
  font-family:Arial,sans-serif;
  color:var(--dark);
  background:#f5fafb;
  line-height:1.6;
}
header {
  background:white;
  padding:16px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
  box-shadow:0 2px 12px #00000012;
}
.logo {
  font-size:25px;
  font-weight:800;
  color:var(--primary);
}
nav { display:flex; gap:15px; flex-wrap:wrap; }
nav a {
  color:var(--dark);
  text-decoration:none;
  font-weight:600;
  font-size:14px;
}
.hero {
  padding:85px 6%;
  text-align:center;
  background:linear-gradient(135deg,#073b4c,#087f8c);
  color:white;
}
.hero h1 {
  font-size:clamp(30px,6vw,54px);
  line-height:1.2;
  margin:0 auto 20px;
  max-width:850px;
}
.hero p {
  max-width:650px;
  margin:0 auto 26px;
}
.btn {
  display:inline-block;
  background:#ffffff;
  color:#087f8c;
  padding:13px 25px;
  border-radius:30px;
  font-weight:bold;
  text-decoration:none;
  border:0;
  cursor:pointer;
}
section { padding:65px 6%; }
.section-title { text-align:center; margin-bottom:30px; }
.section-title h2 { font-size:30px; margin:0; }
.grid {
  max-width:1150px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:22px;
}
.card {
  background:white;
  padding:28px;
  border-radius:18px;
  box-shadow:0 8px 30px #102b3a12;
}
.card h3 { color:var(--primary); }
.card a { color:var(--primary); font-weight:bold; }
.tool {
  max-width:800px;
  margin:auto;
  padding:25px;
  background:white;
  border-radius:18px;
  box-shadow:0 8px 30px #102b3a12;
}
input,textarea {
  display:block;
  width:100%;
  padding:14px;
  margin:12px 0;
  border:1px solid #cbd5e1;
  border-radius:10px;
  font:inherit;
}
button.action {
  background:var(--primary);
  color:white;
  border:0;
  border-radius:10px;
  padding:13px 20px;
  cursor:pointer;
  font-weight:bold;
}
.result {
  margin-top:15px;
  padding:15px;
  background:var(--light);
  border-radius:10px;
  white-space:pre-wrap;
}
.chat {
  max-width:800px;
  margin:auto;
  background:white;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 8px 30px #102b3a18;
}
.chat-head {
  padding:20px;
  background:var(--primary);
  color:white;
  font-weight:bold;
}
.chat-messages {
  height:330px;
  overflow-y:auto;
  padding:20px;
  display:flex;
  flex-direction:column;
  gap:12px;
}
.message {
  max-width:88%;
  padding:12px 15px;
  border-radius:14px;
  white-space:pre-wrap;
}
.bot {
  background:#e9f5f6;
  align-self:flex-start;
}
.user {
  background:var(--primary);
  color:white;
  align-self:flex-end;
}
.chat-form {
  padding:12px;
  display:flex;
  gap:10px;
  border-top:1px solid #ddd;
}
.chat-form input { margin:0; }
footer {
  padding:30px;
  background:var(--dark);
  color:white;
  text-align:center;
}
.small { font-size:13px; color:#536471; }
footer .small { color:#d5e5ea; }
@media(max-width:600px) {
  header { justify-content:center; }
  nav { justify-content:center; }
  section { padding:45px 5%; }
  .hero { padding:65px 5%; }
  .chat-form button { padding:10px; }
}
</style>
</head>

<body>

<header>
  <div class="logo">✚ VITALIS</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#symptoms">Symptoms</a>
    <a href="#chatbot">Chatbot</a>
  </nav>
</header>

<main>
<section class="hero" id="home">
  <h1>Intelligent Healthcare Navigation</h1>
  <p>
    Explore health information, understand common
    symptoms, learn about medicines and find hospitals
    with VITALIS Healthcare AI.
  </p>
  <a href="#chatbot" class="btn">Open Healthcare Chatbot</a>
</section>

<section id="services">
  <div class="section-title">
    <h2>Our Healthcare Services</h2>
    <p>Simple digital tools for healthcare navigation.</p>
  </div>
  <div class="grid">
    <div class="card">
      <h3>🩺 Symptom Guidance</h3>
      <p>Get general information about common symptoms.</p>
      <a href="#symptoms">Explore Symptoms</a>
    </div>
    <div class="card">
      <h3>💊 Medicine Information</h3>
      <p>Learn about medicine uses and important precautions.</p>
      <a href="#medicine">Explore Medicines</a>
    </div>
    <div class="card">
      <h3>🏥 Hospital Finder</h3>
      <p>Search for hospitals in your city using Google Maps.</p>
      <a href="#hospital">Find Hospitals</a>
    </div>
    <div class="card">
      <h3>🤖 Healthcare Chatbot</h3>
      <p>Ask basic health questions and receive general guidance.</p>
      <a href="#chatbot">Start Chatting</a>
    </div>
  </div>
</section>

<section id="symptoms">
  <div class="section-title">
    <h2>Symptom Guidance</h2>
  </div>
  <div class="tool">
    <label for="symptomInput">Describe your symptoms</label>
    <textarea id="symptomInput" rows="3"
      placeholder="Example: I have a headache"></textarea>
    <button class="action" onclick="checkSymptoms()">
      Check Symptoms
    </button>
    <div id="symptomResult" class="result" role="status">
      Enter your symptoms to see general guidance.
    </div>
  </div>
</section>

<section id="medicine">
  <div class="section-title">
    <h2>Medicine Information</h2>
  </div>
  <div class="tool">
    <label for="medicineInput">Enter medicine name</label>
    <input id="medicineInput"
      placeholder="Example: Paracetamol">
    <button class="action" onclick="checkMedicine()">
      Search Medicine
    </button>
    <div id="medicineResult" class="result" role="status">
      Search for basic medicine information.
    </div>
  </div>
</section>

<section id="hospital">
  <div class="section-title">
    <h2>Find Nearby Hospitals</h2>
  </div>
  <div class="tool">
    <label for="cityInput">Enter your city or area</label>
    <input id="cityInput"
      placeholder="Example: Multan, Pakistan">
    <button class="action" onclick="findHospital()">
      Search Hospitals
    </button>
    <p class="small">
      Hospital results will open in Google Maps.
    </p>
  </div>
</section>

<section id="chatbot">
  <div class="section-title">
    <h2>VITALIS Healthcare Chatbot</h2>
    <p>Ask a general healthcare question.</p>
  </div>
  <div class="chat">
    <div class="chat-head">🤖 VITALIS Health Assistant</div>
    <div class="chat-messages" id="chatMessages"
      role="log" aria-live="polite">
      <div class="message bot">
        Hello! Welcome to VITALIS.
        I can provide basic information about
        symptoms, medicines and hospitals.
        How can I help you?
      </div>
    </div>
    <form class="chat-form" id="chatForm">
      <input id="chatInput"
        aria-label="Your message"
        placeholder="Ask a health question..."
        required>
      <button class="action" type="submit">Send</button>
    </form>
  </div>
  <p class="small" style="text-align:center">
    This chatbot provides general educational
    information, not medical diagnosis or treatment.
  </p>
</section>

<section id="about">
  <div class="section-title">
    <h2>About VITALIS</h2>
  </div>
  <div class="tool">
    <p>
      VITALIS is a healthcare technology demonstration
      designed to make basic health information easier
      to access. It combines symptom guidance,
      medicine information, hospital search and a
      rule-based chatbot in one mobile-friendly website.
    </p>
    <p>
      This project demonstrates the potential of
      technology to support healthcare navigation.
      Medical decisions must always be made with
      qualified healthcare professionals.
    </p>
  </div>
</section>
</main>

<footer>
  <strong>VITALIS Healthcare AI</strong>
  <p>Intelligent Healthcare Navigation</p>
  <p class="small">
    Educational project only. Not a replacement
    for professional medical advice.
  </p>
  <p>© 2026 VITALIS. All rights reserved.</p>
</footer>

<script>
"use strict";

const emergencyWords = [
  "chest pain",
  "difficulty breathing",
  "can't breathe",
  "cannot breathe",
  "severe bleeding",
  "unconscious",
  "stroke",
  "suicide",
  "self harm"
];

function isEmergency(text) {
  return emergencyWords.some(word => text.includes(word));
}

function healthAnswer(question) {
  const q = question.toLowerCase();

  if (isEmergency(q)) {
    return "This may be an emergency. Seek immediate medical help or contact your local emergency service. Do not rely on this chatbot.";
  }

  if (q.includes("headache")) {
    return "Headaches have many possible causes, including stress and dehydration. Rest and hydration may help some mild headaches. Seek urgent care for a sudden, extremely severe headache or new neurological symptoms.";
  }

  if (q.includes("fever")) {
    return "Fever can occur with infections and other conditions. Rest, fluids and monitoring may help. Consult a doctor for persistent fever, worsening symptoms or concerning signs.";
  }

  if (q.includes("cough")) {
    return "Coughing can have several causes, including respiratory infections or allergies. Seek medical attention if it persists, worsens or occurs with breathing difficulties.";
  }

  if (q.includes("stomach") || q.includes("abdominal")) {
    return "Stomach pain can have many causes. Seek urgent medical assessment if pain is severe, persistent or accompanied by concerning symptoms.";
  }

  if (q.includes("paracetamol") || q.includes("acetaminophen")) {
    return "Paracetamol (acetaminophen) is commonly used for pain and fever. Taking too much can cause serious liver damage. Check the product label and consult a pharmacist or doctor about safe use.";
  }

  if (q.includes("ibuprofen")) {
    return "Ibuprofen is an anti-inflammatory medicine used for pain and fever. It can cause stomach irritation and may not be suitable for people with certain kidney, stomach or other medical conditions. Ask a pharmacist or doctor before use.";
  }

  if (q.includes("hospital") || q.includes("doctor")) {
    return "You can use the Hospital Finder on this website to search Google Maps for hospitals in your city.";
  }

  if (q.includes("hello") || q.includes("hi")) {
    return "Hello! You can ask me about headaches, fever, cough, stomach pain, paracetamol, ibuprofen or finding hospitals.";
  }

  return "I don't have verified information about that question. Please consult a qualified healthcare professional. You can also ask about common symptoms, medicines or hospital search.";
}

function checkSymptoms() {
  const value = document.getElementById("symptomInput")
    .value.trim();

  const result = document.getElementById("symptomResult");

  if (!value) {
    result.textContent = "Please enter your symptoms.";
    return;
  }

  result.textContent = healthAnswer(value);
}

function checkMedicine() {
  const value = document.getElementById("medicineInput")
    .value.trim().toLowerCase();

  const result = document.getElementById("medicineResult");

  if (!value) {
    result.textContent = "Please enter a medicine name.";
    return;
  }

  if (value.includes("paracetamol") ||
      value.includes("acetaminophen") ||
      value.includes("ibuprofen")) {
    result.textContent = healthAnswer(value);
  } else {
    result.textContent =
      "This medicine is not in the demonstration database. Please ask a qualified pharmacist or doctor for its uses, side effects and safety information.";
  }
}

function findHospital() {
  const city = document.getElementById("cityInput")
    .value.trim();

  if (!city) {
    alert("Please enter your city or area.");
    return;
  }

  const query = encodeURIComponent("hospitals in " + city);

  window.open(
    "https://www.google.com/maps/search/?api=1&query=" + query,
    "_blank",
    "noopener,noreferrer"
  );
}

function addMessage(text, type) {
  const area = document.getElementById("chatMessages");
  const message = document.createElement("div");

  message.className = "message " + type;
  message.textContent = text;

  area.appendChild(message);
  area.scrollTop = area.scrollHeight;
}

document.getElementById("chatForm")
  .addEventListener("submit", function(event) {
    event.preventDefault();

    const input = document.getElementById("chatInput");
    const question = input.value.trim();

    if (!question) return;

    addMessage(question, "user");
    addMessage(healthAnswer(question), "bot");

    input.value = "";
    input.focus();
  });
</script>

</body>
</html>
